# ========================================================
# Telegram Stream Server Configuration
# ========================================================

# 1. Telegram API Credentials (យកពី https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# 2. Telegram Bot Token (យកពី Telegram @BotFather)
BOT_TOKEN=8445405147:AAH51CWfNzBADynBFcGV1yHb5gcraKCnlfY

# 3. Bin Channel ID (Telegram Channel ID សម្រាប់ផ្ទុក Media)
# ចំណាំ៖ ត្រូវ Add Bot ជា Admin ក្នុង Channel នេះជាមុនសិន
# ID ជាទូទៅផ្ដើមដោយ -100 ឧ. -1001234567890
BIN_CHANNEL=-1003909046470

# 4. Server Settings
PORT=8080
HOST=0.0.0.0

# 5. Public URL / Domain (ប្រសិនបើ Run លើ VPS ឬប្រើ Ngrok/Cloudflare)
# ប្រសិនបើ run លើ Localhost ទុកជា default: http://localhost:8080
FQDN=http://localhost:8080

# 6. Bot Security / Private Mode (កំណត់ឱ្យតែម្ចាស់ទើបអាចប្រើ Bot បាន)
# ដាក់លេខ Telegram User ID របស់បង (យកពី @userinfobot)
# អាចដាក់ច្រើន ID ដោយខណ្ឌសញ្ញាក្បៀស (ឧ. 12345678,98765432)
OWNER_ID=

# 7. Hotlink Protection & Allowed Domains (ការពារ Link Video & កំណត់ Domain អនុញ្ញាត)
# (អាចកែប្រែដោយផ្ទាល់លើ Telegram Mini App ដោយមិនបាច់ Restart Server ក៏បាន)
# បើកមុខងារការពារ (true ឬ false)
HOTLINK_PROTECTION=false
# បញ្ជី Domain ដែលអនុញ្ញាតឱ្យយក Link ទៅចាក់ (ខណ្ឌដោយក្បៀស)
ALLOWED_DOMAINS=
# អនុញ្ញាតឱ្យចាក់វីដេអូពេលចុច Link ផ្ទាល់ដោយគ្មាន Referer (true ឬ false)
ALLOW_EMPTY_REFERER=true

